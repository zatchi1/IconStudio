<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IconStudio" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#FFFFFF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">#2A2A2A</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorSecondary">#BDBDBD</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textAppearanceLargePopupMenu">@style/TextAppearance.Zat.PopupMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Zat.PopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.Zat.PopupMenu</item>
    </style>

    <style name="TextAppearance.Zat.PopupMenu" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Home screen: shows the system wallpaper behind the app grid -->
    <style name="Theme.IconStudio.Launcher" parent="Theme.IconStudio">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
